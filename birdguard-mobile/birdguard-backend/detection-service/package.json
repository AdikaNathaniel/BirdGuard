{
  "name": "detection-service",
  "version": "0.0.1",
  "description": "BirdGuard detection-service - TCP microservice reading person-detection events written directly to MongoDB by the Pi",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
