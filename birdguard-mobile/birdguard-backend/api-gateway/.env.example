# api-gateway environment configuration - copy to .env and adjust as needed
HTTP_PORT=3000

# Downstream microservices
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=3001
DEVICE_SERVICE_HOST=127.0.0.1
DEVICE_SERVICE_PORT=3002

# JWT signing secret - MUST match auth-service's JWT_SECRET
JWT_SECRET=replace-with-a-long-random-secret
