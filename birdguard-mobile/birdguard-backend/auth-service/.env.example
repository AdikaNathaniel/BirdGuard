# auth-service environment configuration - copy to .env and adjust as needed
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=3001

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/birdguard

# JWT signing secret - MUST match the value used by api-gateway's JwtAuthGuard
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_SALT_ROUNDS=10
