# device-service environment configuration - copy to .env and adjust as needed
DEVICE_SERVICE_HOST=127.0.0.1
DEVICE_SERVICE_PORT=3002

# Raspberry Pi SSH connection
PI_HOST=192.168.43.233
PI_USERNAME=pi
# Prefer key auth by setting PI_PRIVATE_KEY_PATH; PI_PASSWORD is a fallback for dev.
# If PI_PRIVATE_KEY_PATH is set it takes priority over PI_PASSWORD.
PI_PASSWORD=your-pi-password
PI_PRIVATE_KEY_PATH=/absolute/path/to/id_rsa
# SSH connect timeout in ms
PI_SSH_TIMEOUT_MS=10000
